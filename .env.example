# LLM 配置 - DeepSeek V4 (默认)
# Research Agent 使用 V4-Flash（快速、低成本、Agent能力强）
# Evaluation Agent 使用 V4-Pro（旗舰推理模型，独立评估更可靠）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_EVAL_MODEL=deepseek-v4-pro

# 如果使用OpenAI（备选）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_EVAL_MODEL=gpt-4o

# 预算配置
MAX_TOKENS_PER_TASK=500000
MAX_GPU_MINUTES=60
MAX_WALL_TIME_MINUTES=120
MAX_REVISIONS_PER_STAGE=1

# 存储配置
ARTIFACT_DIR=./data/artifacts
CACHE_DIR=./data/cache
LOG_DIR=./data/logs
WORKSPACE_DIR=./data/workspaces

# 安全配置
SANDBOX_ENABLED=true
SANDBOX_DOCKER_IMAGE=python:3.10-slim
ALLOW_NETWORK_IN_SANDBOX=false

# arXiv 配置
ARXIV_MAX_RESULTS=50
ARXIV_WAIT_TIME=3

# 日志配置
LOG_LEVEL=INFO
